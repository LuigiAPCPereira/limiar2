# limiar-collector — Configuração da Fase 1 (TOML)
# Viper lê variáveis de ambiente com prefixo LIMIAR_; este arquivo documenta
# as chaves equivalentes. Variáveis de ambiente têm precedência sobre os valores do arquivo.

# --- Obrigatório ---
app_id   = 0          # App ID do Telegram (https://my.telegram.org/apps)
api_hash = ""         # API Hash do Telegram

# --- Opcional (valores padrão mostrados) ---
db_path                = "./limiar.db"
log_level              = "info"   # debug | info | warn | error
log_format             = "json"   # json | text
shutdown_timeout       = 15        # segundos, 1-300
max_retries            = 10
io_timeout             = "30s"
dispatcher_buffer_size = 256       # 64-4096
db_writer_buffer_size  = 512       # 128-8192
