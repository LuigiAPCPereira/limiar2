# limiar-collector — Configuração da Fase 1 (variáveis de ambiente)
# Copie para .env e preencha. Todas as variáveis são prefixadas com LIMIAR_.

# --- Obrigatório ---
# Credenciais da API do Telegram em https://my.telegram.org/apps
LIMIAR_APP_ID=
LIMIAR_API_HASH=

# --- Opcional (valores padrão mostrados) ---
# Caminho para o arquivo do banco de dados Tursogo embutido.
LIMIAR_DB_PATH=./limiar.db
# Nível de log: debug | info | warn | error
LIMIAR_LOG_LEVEL=info
# Formato do log: json (serviços) | text (interativo)
LIMIAR_LOG_FORMAT=json
# Segundos permitidos para o desligamento gracioso (graceful shutdown) (1-300).
LIMIAR_SHUTDOWN_TIMEOUT=15
# Máximo de tentativas de reconexão/escrita.
LIMIAR_MAX_RETRIES=10
# Timeout de I/O, ex. 30s, 1m.
LIMIAR_IO_TIMEOUT=30s
# Tamanho do buffer por handler do Dispatcher (64-4096).
LIMIAR_DISPATCHER_BUFFER_SIZE=256
# Tamanho do buffer de fan-in do DBWriter (128-8192).
LIMIAR_DB_WRITER_BUFFER_SIZE=512
