# limiar-collector — Phase 1 configuration (environment variables)
# Copy to .env and fill in. All variables are prefixed LIMIAR_.

# --- Required ---
# Telegram API credentials from https://my.telegram.org/apps
LIMIAR_APP_ID=
LIMIAR_API_HASH=

# --- Optional (defaults shown) ---
# Path to the embedded Tursogo database file.
LIMIAR_DB_PATH=./limiar.db
# Log level: debug | info | warn | error
LIMIAR_LOG_LEVEL=info
# Log format: json (services) | text (interactive)
LIMIAR_LOG_FORMAT=json
# Seconds allowed for graceful shutdown (1-300).
LIMIAR_SHUTDOWN_TIMEOUT=15
# Max reconnect/write retries.
LIMIAR_MAX_RETRIES=10
# I/O timeout, e.g. 30s, 1m.
LIMIAR_IO_TIMEOUT=30s
# Dispatcher per-handler buffer size (64-4096).
LIMIAR_DISPATCHER_BUFFER_SIZE=256
# DBWriter fan-in buffer size (128-8192).
LIMIAR_DB_WRITER_BUFFER_SIZE=512
